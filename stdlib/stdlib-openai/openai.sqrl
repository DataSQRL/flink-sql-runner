IMPORT schema.data;
IMPORT target.*;

results := SELECT prompt,
            completions(prompt, 'gpt-6-luna') AS completions_result,
            extract_json(prompt, 'gpt-6-luna') AS extract_json_result,
            CAST(vector_embed(prompt, 'text-embedding-ada-002') AS STRING) AS vector_embed_result
           FROM data;
